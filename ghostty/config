window-padding-x = 10,10
window-padding-y = 10,10

font-family = "JetBrains Mono Nerd Font"
font-size = 11
cursor-style = block

shell-integration = fish
command = fish

theme = tokyonight-night

tab-inherit-working-directory = true
split-inherit-working-directory = true
window-inherit-working-directory = true

notify-on-command-finish = unfocused
notify-on-command-finish-after = 10s

shell-integration-features = title,ssh-env,ssh-terminfo

scrollback-limit = 100000000

quick-terminal-position = top
quick-terminal-size = 35%

keybind = ctrl+t=new_tab
keybind = ctrl+w=close_tab
keybind = ctrl+shift+h=previous_tab
keybind = ctrl+shift+l=next_tab

keybind = global:ctrl+backquote=toggle_quick_terminal
