window-padding-x = 10,10
window-padding-y = 10,10

font-family = "JetBrains Mono Nerd Font"
font-size = 11
cursor-style = block

shell-integration = fish
command = fish

theme = jb-dark

tab-inherit-working-directory = true
split-inherit-working-directory = true
window-inherit-working-directory = true

notify-on-command-finish = unfocused
notify-on-command-finish-after = 10s

shell-integration-features = title,ssh-env,ssh-terminfo

# bytes of scrollback per surface (upstream default is 10000000)
# was 100000000; lowered because heavy TUI output + Ghostty's page-reuse
# leak made large limits multiply memory use
scrollback-limit = 10000000

quick-terminal-position = top
quick-terminal-size = 35%

keybind = ctrl+t=new_tab
keybind = ctrl+w=close_tab
keybind = ctrl+shift+h=previous_tab
keybind = ctrl+shift+l=next_tab

keybind = global:ctrl+backquote=toggle_quick_terminal
