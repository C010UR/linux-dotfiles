[Unit]
Description=Forward Noctalia notification actions to Twingate's listener connection
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/bin/twingate-notification-bridge.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
